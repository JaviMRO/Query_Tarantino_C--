{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release",
      "description": "Release build (-O2 -DNDEBUG, SPEC §11) with tests and benchmarks; MongoDB support when mongocxx is installed",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "release-mongo",
      "inherits": "release",
      "displayName": "Release with MongoDB",
      "description": "Release build that downloads and builds the MongoDB C++ driver, for the mongo index and metadata",
      "binaryDir": "${sourceDir}/build/release-mongo",
      "cacheVariables": {
        "TARANTINO_MONGO": "FETCH"
      }
    },
    {
      "name": "debug",
      "inherits": "release",
      "displayName": "Debug",
      "description": "Debug build, for development only: its benchmark results are not comparable",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release"
    },
    {
      "name": "release-mongo",
      "configurePreset": "release-mongo",
      "configuration": "Release"
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-mongo",
      "configurePreset": "release-mongo",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
